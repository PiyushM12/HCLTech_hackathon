# Copy to .env and adjust. All values are optional.

# true = run without any LLM (deterministic heuristics for classification and free-text answers)
MOCK_LLM=false

# Local Ollama. From Docker on Windows/macOS the host is reachable as host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=60
# Let the LLM write free-text answers from retrieved passages (structured answers are always code-composed)
LLM_COMPOSE=true

# Multilingual embedding model (must cover hi, kn, ta, en). Changing it requires a re-index:
#   docker compose exec api python scripts/build_kb.py --force
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Authentication (roles: admin, user). Change these for any shared or public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Citizens sign in with their citizen ID (e.g. C1001) and this password; accounts are created on first sign-in
DEMO_CITIZEN_PASSWORD=citizen123
# Secret that signs login tokens: set a long random value in production
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_MINUTES=720
# true = /ask and actions also accept a bare X-Citizen-Id header without a token (the guide's API contract)
ALLOW_HEADER_IDENTITY=true
# true = anyone may call POST /ingest and POST /admin/load (judging laptop only). Default: admin only
OPEN_ADMIN_ENDPOINTS=false

# No cloud LLM or translation service is used. None is configured.